DATABASE_URL=mysql://whatsapp_user:MYSQL_PASSWORD@db:3306/whatsapp_dashboard
NEXTAUTH_SECRET=your-random-secret-here
NEXTAUTH_URL=https://wadesk.in
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=mywebhook123
# App Secret from Meta App Dashboard -> Settings -> Basic (NOT the same value
# as META_ACCESS_TOKEN). Verifies the X-Hub-Signature-256 header on every
# inbound POST /api/webhook delivery so a forged payload can't be POSTed to
# this URL and processed as a real message/call/status update. Until this is
# set, verification is skipped (loudly logged) rather than breaking live
# inbound WhatsApp traffic — set this as soon as possible after deploying.
META_APP_SECRET=
MYSQL_ROOT_PASSWORD=your-root-password
MYSQL_PASSWORD=your-db-password

# CRM integration (server-to-server calls, all from the NEDS CRM — see
# CLAUDE.md's Authentication flow section), scoped per purpose so a leaked
# key only grants what that purpose needs:
# WADESK_SERVICE_KEY_MESSAGING: send/send-template (real financial exposure —
#   unlimited paid WhatsApp sends if leaked).
# WADESK_SERVICE_KEY_LEAD_SYNC: conversations/mute, leads/sync,
#   leads/set-cover (lead ownership/routing data mutation).
# WADESK_SERVICE_KEY_READ: media/[id], ai/usage (read-only).
WADESK_SERVICE_KEY_MESSAGING=
WADESK_SERVICE_KEY_LEAD_SYNC=
WADESK_SERVICE_KEY_READ=
# Legacy, unscoped — still accepted as a fallback by every route during
# rollout. Remove this once the CRM is confirmed sending the new scoped
# keys above (see the CRM's backlog memory for the checklist).
WADESK_SERVICE_KEY=
# Outbound: new/reopened conversation -> CRM support ticket
CRM_WEBHOOK_URL=
CRM_WEBHOOK_TOKEN=
# Outbound: a message sent via /api/send-template later reported FAILED by
# Meta's async status webhook -> CRM VisibilityAuditTouch downgrade. Reuses
# CRM_WEBHOOK_TOKEN above, same trust boundary.
CRM_MESSAGE_FAILED_URL=
# Inbound (CRM -> here): the after-hours assistant's lead-context lookup
# before drafting a reply. Reuses CRM_WEBHOOK_TOKEN above. Was already used
# by src/lib/crm-lead-context.ts but missing from this file -- added
# 2026-09-08 alongside CRM_GOAL_CAPTURE_URL below, same real gap class as
# the CRM repo's own WADESK_MARKETING_NUMBER .env.example omission.
CRM_LEAD_CONTEXT_URL=
# Outbound: the goal-question flow's write-back once a lead answers over
# WhatsApp (src/lib/goal-flow.ts / crm-goal-capture.ts). Reuses
# CRM_WEBHOOK_TOKEN above, same trust boundary.
CRM_GOAL_CAPTURE_URL=
