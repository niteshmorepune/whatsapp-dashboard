generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  AGENT
}

enum ConversationStatus {
  OPEN
  RESOLVED
  PENDING
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
  FAILED
}

enum BroadcastStatus {
  DRAFT
  SENDING
  COMPLETED
  FAILED
}

enum RecipientStatus {
  PENDING
  SENT
  FAILED
}

// AUTO: AI replies only outside the configured business hours/holidays for
// this line. FORCE_ON / FORCE_OFF override the schedule entirely — used for
// a short-staffed day (force on during hours) or a wanted-human-touch
// period (force off outside hours).
enum AiMode {
  AUTO
  FORCE_ON
  FORCE_OFF
}

model Agent {
  id                String                @id @default(cuid())
  name              String
  email             String                @unique
  passwordHash      String
  role              Role                  @default(AGENT)
  isActive          Boolean               @default(true)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  conversations     Conversation[]
  messages          Message[]
  contactNotes      ContactNote[]
  broadcasts        Broadcast[]
  pushSubscriptions PushSubscription[]
  whatsappNumberGrants AgentWhatsappNumber[]
}

// A single Meta WABA can host several phone numbers (e.g. one for
// post-sale support, one for pre-sale marketing). Every Conversation and
// Broadcast belongs to exactly one of these; agent access is granted
// per-number via AgentWhatsappNumber, independent of Role.
model WhatsappNumber {
  id             String                @id @default(cuid())
  label          String
  businessNumber String                @unique
  phoneNumberId  String                @unique
  wabaId         String
  accessToken    String                @db.Text
  isDefault      Boolean               @default(false)
  // AI after-hours assistant (see src/lib/business-hours.ts, src/lib/ai-reply.ts).
  // businessHours is a 7-entry array, one per JS Date#getDay() index (0=Sun):
  // [{ day: 0-6, isOpen: boolean, openTime: "HH:mm", closeTime: "HH:mm" }].
  // Times are interpreted in Asia/Kolkata — this app is single-timezone (NEDS
  // is an India-only business), so no per-number timezone field is stored.
  aiMode         AiMode                @default(AUTO)
  businessHours  Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  conversations  Conversation[]
  broadcasts     Broadcast[]
  agentGrants    AgentWhatsappNumber[]
}

// Company-wide holiday calendar (not per-line — a holiday is a holiday for
// everyone). Consulted by isWithinBusinessHours() alongside each line's own
// weekly schedule.
model Holiday {
  id        String   @id @default(cuid())
  date      DateTime @db.Date
  label     String
  createdAt DateTime @default(now())

  @@unique([date])
}

// Admin-maintained knowledge base the AI after-hours assistant is grounded
// in — it must never answer from outside this list (pricing, timelines,
// commitments). Separate from QuickReply, which is agent-facing canned text
// inserted manually, not AI context.
model FaqEntry {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AgentWhatsappNumber {
  id               String         @id @default(cuid())
  agentId          String
  whatsappNumberId String
  createdAt        DateTime       @default(now())
  agent            Agent          @relation(fields: [agentId], references: [id], onDelete: Cascade)
  whatsappNumber   WhatsappNumber @relation(fields: [whatsappNumberId], references: [id], onDelete: Cascade)

  @@unique([agentId, whatsappNumberId])
  @@index([whatsappNumberId])
}

model PushSubscription {
  id        String   @id @default(cuid())
  agentId   String
  endpoint  String   @unique @db.VarChar(500)
  p256dh    String   @db.Text
  auth      String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

model Contact {
  id                 String               @id @default(cuid())
  phone              String               @unique
  name               String?
  email              String?
  tags               Json                 @default("[]")
  optedOut           Boolean              @default(false)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  conversations      Conversation[]
  notes              ContactNote[]
  broadcastRecipients BroadcastRecipient[]
}

model Conversation {
  id               String             @id @default(cuid())
  contactId        String
  agentId          String?
  whatsappNumberId String
  status           ConversationStatus @default(OPEN)
  lastMessageAt    DateTime           @default(now())
  windowExpiresAt  DateTime?
  // Set true the moment any human agent sends on this thread, so the AI
  // after-hours assistant stops replying here even if it's still "live" for
  // the line as a whole. Manually reset via the "Resume AI" action.
  aiMuted          Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  contact          Contact            @relation(fields: [contactId], references: [id])
  agent            Agent?             @relation(fields: [agentId], references: [id])
  whatsappNumber   WhatsappNumber     @relation(fields: [whatsappNumberId], references: [id])
  messages         Message[]

  @@index([contactId])
  @@index([agentId])
  @@index([whatsappNumberId])
  @@index([status])
  @@index([lastMessageAt])
}

model Message {
  id             String           @id @default(cuid())
  conversationId String
  direction      MessageDirection
  content        String           @db.Text
  mediaUrl       String?
  mediaType      String?
  metaMessageId  String?          @unique
  status         MessageStatus    @default(SENT)
  sentByAgentId  String?
  // True for a message the AI after-hours assistant sent on its own
  // (sentByAgentId stays null for these, same as a CRM-forwarded send).
  sentByAi       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  conversation   Conversation     @relation(fields: [conversationId], references: [id])
  sentByAgent    Agent?           @relation(fields: [sentByAgentId], references: [id])

  @@index([conversationId])
  @@index([sentByAgentId])
}

model Template {
  id             String      @id @default(cuid())
  name           String      @unique
  content        String      @db.Text
  category       String
  isApproved     Boolean     @default(false)
  metaTemplateId String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  broadcasts     Broadcast[]
}

model QuickReply {
  id        String   @id @default(cuid())
  name      String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactNote {
  id        String   @id @default(cuid())
  contactId String
  agentId   String
  content   String   @db.Text
  createdAt DateTime @default(now())
  contact   Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)
  agent     Agent    @relation(fields: [agentId], references: [id])

  @@index([contactId])
}

model Broadcast {
  id               String               @id @default(cuid())
  name             String
  templateId       String
  agentId          String
  whatsappNumberId String
  status           BroadcastStatus      @default(DRAFT)
  sentCount        Int                  @default(0)
  failedCount      Int                  @default(0)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  template         Template             @relation(fields: [templateId], references: [id])
  agent            Agent                @relation(fields: [agentId], references: [id])
  whatsappNumber   WhatsappNumber       @relation(fields: [whatsappNumberId], references: [id])
  recipients       BroadcastRecipient[]

  @@index([agentId])
  @@index([whatsappNumberId])
}

model BroadcastRecipient {
  id            String          @id @default(cuid())
  broadcastId   String
  contactId     String
  status        RecipientStatus @default(PENDING)
  metaMessageId String?
  createdAt     DateTime        @default(now())
  broadcast     Broadcast       @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  contact       Contact         @relation(fields: [contactId], references: [id])

  @@index([broadcastId])
  @@index([contactId])
}
